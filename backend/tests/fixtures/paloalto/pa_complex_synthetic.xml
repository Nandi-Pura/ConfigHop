            <entry name="ethernet1/12.264"><tag>264</tag><ip><entry name="192.0.2.17/28" /></ip></entry>
            <entry name="ethernet1/12.265"><tag>265</tag><ip><entry name="192.0.2.33/28" /></ip></entry>
            <entry name="ethernet1/12.266"><tag>266</tag><ip><entry name="192.0.2.49/28" /></ip></entry>
            <entry name="ethernet1/12.2204"><tag>2204</tag><ip><entry name="192.0.2.65/28" /></ip></entry>
          </units></layer3></entry>
          <entry name="ethernet1/13"><layer2><units><entry name="ethernet1/13.30"><tag>30</tag></entry></units></layer2></entry>
        </ethernet>
        <aggregate-ethernet><entry name="ae1"><layer3><ip><entry name="198.51.100.1/24" /></ip></layer3></entry></aggregate-ethernet>
        <vlan><units><entry name="vlan.30"><ip><entry name="203.0.113.30/24" /></ip></entry></units></vlan>
