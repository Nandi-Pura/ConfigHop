VITE_CONFIGHOP_API_URL=http://127.0.0.1:8000/api/v1
# Required for target baseline collection. Use a stable, secret, base64-encoded 32-byte key.
CONFIGHOP_ARTIFACT_KEY_B64=
# Exact IP:port allowlists. Leave empty until the offline implementation gate passes.
CONFIGHOP_SOURCE_ENDPOINTS=
CONFIGHOP_TARGET_ENDPOINTS=
# disabled is the safe default. lab enables stage and validate, never commit.
CONFIGHOP_DEPLOYMENT_MODE=disabled
